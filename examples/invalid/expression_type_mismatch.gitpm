repository Demo;

member Alice role developer workloadLimit 3;

label bug;

board MainBoard {
    column Backlog;
}

rule TypeMismatch {
    on issue opened;
    when hasLabel(bug);
    do {
        let invalidComparison = 3 == "three";

        if invalidComparison then {
            add comment "Invalid then branch.";
        } else {
            add comment "Invalid else branch.";
        }
    }
}